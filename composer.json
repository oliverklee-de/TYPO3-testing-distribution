{
	"name": "oliverklee/typo3-testing-distribution",
	"description": "TYPO3 CMS distribution for testing extensions",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"authors": [
		{
			"name": "Oliver Klee",
			"homepage": "https://www.oliverklee.de",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/oliverklee-de/TYPO3-testing-distribution/issues",
		"source": "https://github.com/oliverklee-de/TYPO3-testing-distribution"
	},
	"require": {
		"php": "^7.4 || ^8.0",
		"helhum/typo3-console": "^7.1.4",
		"oliverklee/feuserextrafields": "6.7.1",
		"oliverklee/oelib": "6.3.1",
		"oliverklee/onetimeaccount": "7.3.1",
		"oliverklee/seminars": "dev-main",
		"oliverklee/site-dev": "@dev",
		"ttn/tea": "^3.1.0",
		"typo3/cms-adminpanel": "^11.5",
		"typo3/cms-belog": "^11.5",
		"typo3/cms-beuser": "^11.5",
		"typo3/cms-composer-installers": "^4.0.0-rc1",
		"typo3/cms-core": "^11.5.10",
		"typo3/cms-dashboard": "^11.5",
		"typo3/cms-felogin": "^11.5",
		"typo3/cms-filelist": "^11.5",
		"typo3/cms-filemetadata": "^11.5",
		"typo3/cms-fluid-styled-content": "^11.5",
		"typo3/cms-form": "^11.5",
		"typo3/cms-impexp": "^11.5",
		"typo3/cms-indexed-search": "^11.5",
		"typo3/cms-info": "^11.5",
		"typo3/cms-lowlevel": "^11.5",
		"typo3/cms-recycler": "^11.5",
		"typo3/cms-redirects": "^11.5",
		"typo3/cms-reports": "^11.5",
		"typo3/cms-rte-ckeditor": "^11.5",
		"typo3/cms-scheduler": "^11.5",
		"typo3/cms-seo": "^11.5",
		"typo3/cms-setup": "^11.5",
		"typo3/cms-tstemplate": "^11.5",
		"typo3/cms-viewpage": "^11.5",
		"typo3/cms-workspaces": "^11.5",
		"typo3/minimal": "^11.5"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "2.50.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0",
		"symfony/yaml": "5.4.53"
	},
	"repositories": [
		{
			"type": "path",
			"url": "src/extensions/*"
		}
	],
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"audit": {
			"block-insecure": false,
			"block-abandoned": false
		},
		"lock": false,
		"preferred-install": {
			"*": "dist"
		},
		"sort-packages": true
	},
	"scripts": {
		"post-autoload-dump": [
			"@typo3-cms-scripts"
		],
		"check:composer:normalize": [
			"@composer normalize --dry-run --no-check-lock",
			"@composer normalize --dry-run --no-check-lock src/extensions/site-dev/composer.json"
		],
		"check:php:lint": "parallel-lint public/typo3conf/LocalConfiguration.php src/extensions/site-dev",
		"check:static": [
			"@check:composer:normalize",
			"@check:php:lint",
			"@check:yaml:lint"
		],
		"check:yaml:lint": "find .ddev .github config src/extensions/site-dev -name '*.yml' -o -name '*.yaml' | xargs php ./vendor/bin/yaml-lint",
		"fix": [
			"@fix:composer"
		],
		"fix:composer": [
			"@composer normalize --no-check-lock",
			"@composer normalize --no-check-lock src/extensions/site-dev/composer.json"
		],
		"typo3-cms-scripts": [
			"typo3cms install:fixfolderstructure"
		]
	},
	"scripts-descriptions": {
		"check:composer:normalize": "Checks the formatting and structure of the composer.json.",
		"check:php:lint": "Lints the PHP files for syntax errors.",
		"check:static": "Runs all static code checks (syntax, style, types).",
		"check:yaml:lint": "Lints the YAML files for syntax errors.",
		"fix": "Reformats the code.",
		"fix:composer": "Reformats and sorts the composer.json files."
	}
}
